# Bearer token required by POST /migrations and GET /migrations/{id}.
FRONTIER_PLATFORM_API_KEY=change-me

# Fernet key that encrypts stored secrets. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FRONTIER_SECRETS_MASTER_KEY=

# Optional
# FRONTIER_DATABASE_PATH=data/frontier.db
# FRONTIER_CHECKPOINT_DATABASE_PATH=data/checkpoints.db
# FRONTIER_MAX_CONCURRENT_JOBS=1
# FRONTIER_LOG_FORMAT=console  # or json

# LLM gateway (OpenRouter, Anthropic-compatible endpoint)
# Do not set ANTHROPIC_AUTH_TOKEN or ANTHROPIC_BASE_URL for this service.
OPENROUTER_API_KEY=
# Optional
# FRONTIER_LLM_BASE_URL=https://openrouter.ai/api
# FRONTIER_LLM_MODEL=anthropic/claude-haiku-5.5
# FRONTIER_LLM_MAX_TOKENS=8192
# FRONTIER_LLM_TIMEOUT_S=120
# FRONTIER_LLM_MAX_RETRIES=2

# Guardrails (OpenRouter Decisions API, reuses OPENROUTER_API_KEY). Optional
# FRONTIER_GUARDRAIL_URL=https://openrouter.ai/api/alpha/decisions
# FRONTIER_GUARDRAIL_MODEL=typesafe/jev-1.13
# FRONTIER_GUARDRAIL_TIMEOUT_S=15
# FRONTIER_GUARDRAIL_BLOCK_THRESHOLD=0.5
# FRONTIER_GUARDRAIL_CHUNK_CHARS=60000

# Vercel Sandbox (access token from vercel.com/account/tokens)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Optional
# FRONTIER_SANDBOX_RUNTIME=python3.13
# FRONTIER_SANDBOX_TIMEOUT_S=600
# FRONTIER_SANDBOX_COMMAND_TIMEOUT_S=300
